{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["clusterId"],
  "properties": {
    "clusterId": {
      "type": "string",
      "description": "UUID of the UKS cluster to autoscale.",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "upcloud": {
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "autoscaler": {
      "type": "object",
      "properties": {
        "extraArgs": { "type": "object" }
      }
    },
    "nodeGroups": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "$ref": "#/definitions/nodeGroupSettings" },
        "overrides": {
          "type": "object",
          "description": "Settings for specific node groups, keyed by UKS node group name.",
          "additionalProperties": { "$ref": "#/definitions/nodeGroupSettings" }
        }
      }
    }
  },
  "definitions": {
    "nodeGroupSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "description": "Fewest nodes. UKS doesn't allow empty node groups."
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "description": "Most nodes. The provider rejects a max above the cluster's per-group cap, or below min."
        },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
